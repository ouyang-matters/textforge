    pathex=[project_root],
    binaries=[],
    datas=[
        (frontend_dist, 'frontend'),
    ],
    hiddenimports=[
        'textforge',
        'textforge.api',
        'textforge.config',
        'textforge.models',
        'textforge.pipeline',
        'textforge.desktop_server',
        'textforge.services',
